{
  "name": "univpn",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "android": "bun run --cwd apps/mobile android",
    "ios": "bun run --cwd apps/mobile ios",
    "mobile": "bun run --cwd apps/mobile start",
    "desktop": "bun run --cwd apps/desktop dev",
    "release": "./scripts/release.sh",
    "bump": "bun scripts/version.ts bump",
    "check:versions": "bun scripts/version.ts check"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
