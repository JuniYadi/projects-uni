# LOCAL DEV (development server)
# Dipakai saat `npm start` / lokal development
EXPO_PUBLIC_API_BASE_URL=https://pfnapp.my.id/api/vpn/mobile
EXPO_PUBLIC_APP_URL=https://pfnapp.my.id
EXPO_PUBLIC_SKIP_AUTH=0

# NOTE: Untuk EAS Build, env otomatis di-inject lewat eas.json per profile:
#   development  → pfnapp.my.id  (dev/staging API)
#   preview      → pfnapp.my.id  (dev/staging API, untuk internal/closed test)
#   production   → pfnapp.id     (production API)
#
# File .env ini HANYA dipakai untuk local dev (npm start), BUKAN EAS Build.
